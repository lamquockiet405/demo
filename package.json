{
  "name": "kids-nutri-journal-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KidsNutriJournal - Hệ thống Quản lý Dinh dưỡng và Bữa ăn Bán trú tại Trường Mầm non",
  "scripts": {
    "dev:backend": "pnpm --filter @kidsnutri/backend dev",
    "dev:frontend": "pnpm --filter @kidsnutri/frontend dev",
    "build": "pnpm --filter \"@kidsnutri/*\" build",
    "lint": "pnpm --filter \"@kidsnutri/*\" lint",
    "test": "npm --prefix apps/backend run test",
    "test:unit": "npm --prefix apps/backend run test",
    "test:api": "npm --prefix apps/backend run test:e2e",
    "test:all": "npm --prefix apps/backend run test && npm --prefix apps/backend run test:e2e",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:verify": "node database/verify_schema.js",
    "db:source:generate": "node scripts/import-source-catalog.cjs",
    "db:source:apply": "node scripts/import-source-catalog.cjs --apply",
    "db:source:test": "node --test scripts/test/source-catalog.test.cjs",
    "db:docker:source:apply": "node scripts/apply-source-catalog-docker.cjs",
    "db:export:view": "node scripts/export-database-snapshot.cjs",
    "db:erd": "node scripts/generate-erd.cjs",
    "db:relations:check": "node scripts/migrate-relations.cjs",
    "db:relations:apply": "node scripts/migrate-relations.cjs --apply",
    "db:relations:test": "node scripts/test-relations-docker.cjs",
    "test:database": "node --test scripts/test/*.test.cjs",
    "docker:test:up": "node scripts/prepare-docker-test.cjs && docker compose --env-file .docker-test/test.env -f compose.test.yml up -d --build --wait"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "esbuild"
    ]
  }
}
